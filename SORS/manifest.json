{
    "manifest_version": 3,
    "name": "Steam Order Scanner",
    "version": "2.0.0",
    "short_name": "SORS",
    "description": "Helps keep your Steam Market buy orders profitable and enhances market pages with useful features.",
    "icons": {
        "16": "ico/16.png",
        "48": "ico/48.png",
        "128": "ico/128.png"
    },
    "permissions": ["storage"],
    "host_permissions": ["*://steamcommunity.com/*"],
    "action": {
        "default_popup": "ext/popup/popup.html"
    },
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "https://steamcommunity.com/market",
                "https://steamcommunity.com/market/*"
            ],
            "css": ["site/listing/listing-order-depth.css"],
            "js": [
                "site/market/steam-currency.js",
                "site/listing/listings.js",
                "site/listing/listing-order-depth.js"
            ],
            "run_at": "document_start"
        },
        {
            "matches": [
                "https://steamcommunity.com/market",
                "https://steamcommunity.com/market/*"
            ],
            "css": ["site/market/account-market.css", "site/scanner/panel.css"],
            "js": [
                "site/market/account-market-data.js",
                "site/scanner/panel.js",
                "site/market/buy-orders.js",
                "site/market/active-listings.js",
                "site/market/account-market.js",
                "site/scanner/item-prices.js",
                "site/scanner/runner.js"
            ],
            "run_at": "document_idle"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": ["site/market/steam-market-fees.js", "site/listing/listings.page.js"],
            "matches": ["*://steamcommunity.com/*"]
        }
    ]
}
